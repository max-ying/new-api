# Compose interpolation and runtime settings.
NEW_API_IMAGE=new-api
NEW_API_VERSION=
NEW_API_BIND=127.0.0.1
NEW_API_PORT=3001
POSTGRES_PASSWORD=
GIT_COMMIT=
BUILD_DATE=
SOURCE_URL=https://github.com/max-ying/new-api.git
TZ=Asia/Shanghai

# China-friendly build sources. Override these values if a mirror is unavailable.
